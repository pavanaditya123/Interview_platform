PORT=3000
NODE_ENV=development
DB_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/interview-platform

# Inngest (syncs Clerk users into MongoDB + Stream)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Stream (video + chat)
STREAM_API_KEY=
STREAM_API_SECRET=

# Clerk (auth)
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Comma-separated allowed origins for CORS (frontend dev server in development)
CLIENT_URL=http://localhost:5173

# Optional: self-hosted Piston for running Java (JS/Python run in the browser)
PISTON_API_URL=


# AI hints + code review: set ONE (free keys: console.groq.com / aistudio.google.com)
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
